@model NexusERP_D2.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="container mt-4">
    <h2>Delete Client</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this client? This action cannot be undone.
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5>@Model.Name</h5>
            <p class="mb-1"><strong>Contact:</strong> @Model.ContactPerson</p>
            <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
            <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
            <p class="mb-0"><strong>Type:</strong> @Model.ClientType</p>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>