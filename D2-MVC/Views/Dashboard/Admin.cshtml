@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <h1>Admin Dashboard</h1>

    <p class="text-muted">
        Welcome to NexusERP Administration.
    </p>

    <div class="row g-3 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5>User Management</h5>
                <p>Manage ERP users and their roles.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5>Department Management</h5>
                <p>Manage organizational departments.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5>System Overview</h5>
                <p>View overall ERP information.</p>
            </div>
        </div>

        <div class="mt-4">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-primary">
                Manage Users
            </a>
        </div>

        <div class="mt-3">
            <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-primary">
                Manage Employees
            </a>
        </div>

        <a asp-controller="Department"
           asp-action="Index"
           class="btn btn-primary">
            Manage Departments
        </a>

    </div>
</div>
