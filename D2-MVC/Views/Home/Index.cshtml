@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
}

<!-- Hero Section -->
<section class="hero-section" id="home">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="badge bg-light text-primary mb-3 p-2">
                    BUSINESS MANAGEMENT PLATFORM
                </span>

                <h1 class="display-4 fw-bold text-white">
                    Manage Your Business.
                    <span class="hero-highlight">All in One Place.</span>
                </h1>

                <p class="lead text-light mt-4">
                    NexusERP brings your employees, clients, projects
                    and financial operations together in one centralized
                    business management platform.
                </p>

                <div class="mt-4">
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-light btn-lg me-2">

                        Get Started
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <a href="#modules"
                       class="btn btn-outline-light btn-lg">
                        Explore Modules
                    </a>
                </div>

            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="hero-card">

                    <h5 class="fw-bold mb-4">
                        Business Overview
                    </h5>

                    <div class="row g-3">

                        <div class="col-6">
                            <div class="overview-box">
                                <i class="bi bi-people text-primary fs-3"></i>
                                <h3>48</h3>
                                <small>Employees</small>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="overview-box">
                                <i class="bi bi-kanban text-success fs-3"></i>
                                <h3>16</h3>
                                <small>Projects</small>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="overview-box">
                                <i class="bi bi-person-check text-warning fs-3"></i>
                                <h3>24</h3>
                                <small>Clients</small>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="overview-box">
                                <i class="bi bi-receipt text-danger fs-3"></i>
                                <h3>85K</h3>
                                <small>Pending Invoices</small>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>


<!-- Features Section -->
<section class="py-5" id="features">
    <div class="container">

        <div class="text-center mb-5">
            <h6 class="text-primary fw-bold">WHY NEXUSERP?</h6>

            <h2 class="fw-bold">
                Everything Your Business Needs
            </h2>

            <p class="text-muted">
                Simplify operations and improve team coordination.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">

                    <i class="bi bi-diagram-3 feature-icon"></i>

                    <h5 class="fw-bold mt-3">
                        Centralized Operations
                    </h5>

                    <p class="text-muted">
                        Manage important business information from
                        one centralized platform.
                    </p>

                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">

                    <i class="bi bi-people feature-icon"></i>

                    <h5 class="fw-bold mt-3">
                        Team Collaboration
                    </h5>

                    <p class="text-muted">
                        Keep employees, managers and departments
                        connected and organized.
                    </p>

                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">

                    <i class="bi bi-graph-up-arrow feature-icon"></i>

                    <h5 class="fw-bold mt-3">
                        Business Insights
                    </h5>

                    <p class="text-muted">
                        Monitor projects, expenses, invoices and
                        business performance.
                    </p>

                </div>
            </div>

        </div>
    </div>
</section>


<!-- Modules Section -->
<section class="py-5 bg-white" id="modules">
    <div class="container">

        <div class="text-center mb-5">
            <h6 class="text-primary fw-bold">OUR MODULES</h6>

            <h2 class="fw-bold">
                Four Core Business Modules
            </h2>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="module-card">

                    <i class="bi bi-people module-icon"></i>

                    <h5>People & Clients</h5>

                    <p>
                        Employee profiles, client records,
                        departments and attendance.
                    </p>

                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="module-card">

                    <i class="bi bi-kanban module-icon"></i>

                    <h5>Projects & Operations</h5>

                    <p>
                        Project assignments, tasks,
                        deadlines and timesheets.
                    </p>

                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="module-card">

                    <i class="bi bi-wallet2 module-icon"></i>

                    <h5>Finance & Billing</h5>

                    <p>
                        Budgets, expenses, invoices
                        and payment records.
                    </p>

                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="module-card">

                    <i class="bi bi-bar-chart module-icon"></i>

                    <h5>Reports & Insights</h5>

                    <p>
                        Business performance and
                        financial reporting.
                    </p>

                </div>
            </div>

        </div>
    </div>
</section>
